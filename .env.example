# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).

# Port the server listens on locally
PORT=3000

# MongoDB connection string (MongoDB Atlas > Connect > Drivers)
MONGO_URI=

# Signs the login cookies. Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=

# The site's public address once it's online, e.g. https://feetfirst.ng
# (used for the Paystack return link). Leave empty locally.
PUBLIC_URL=

# ---------- Paystack ----------
# Dashboard > Settings > API Keys & Webhooks. Start with the test key (sk_test_...).
# Leave empty while developing: payments are then simulated and no money moves.
PAYSTACK_SECRET_KEY=

# Online without a Paystack key yet: set to true to allow fake payments while
# trying the site out. Remove before real customers use the site.
SIMULATE_PAYMENTS=

# ---------- Emails (Resend) ----------
# https://resend.com > API Keys. Without it, emails are skipped.
RESEND_API_KEY=

# Who emails come from. onboarding@resend.dev only delivers to your own Resend
# account's address. To email customers, verify your domain in Resend and use
# an address on it, e.g. FeetFirst <orders@feetfirst.ng>
EMAIL_FROM=FeetFirst <onboarding@resend.dev>

# ---------- Admin account (for npm run seed:admin) ----------
# Fill these in, run `npm run seed:admin`, then delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=FeetFirst Admin

# Set to production on your host
NODE_ENV=
